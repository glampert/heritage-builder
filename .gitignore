# Generated by cargo
Cargo.lock
**/Cargo.lock

# Build artifacts
/target/

# Apple stuff
.DS_Store

# Python bytecode caches (tool scripts under crates/tools/)
__pycache__/
*.pyc

# Log files
*.log

# Generated web/wasm files
HeritageBuilder.js
HeritageBuilder_bg.wasm

# Local logs & runtime cache
/logs/
/cache/

# Screenshots (hotkey) and one-off output such as --screenshot-out images
/screenshots/
/out/

# Save games are local runtime state — ignore everything under saves/,
# except the committed sample-maps archive.
/saves/*
!/saves/sample_saves.zip
