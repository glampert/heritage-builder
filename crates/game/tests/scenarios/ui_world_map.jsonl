# ---- The next mission's choice: the hidden test campaigns (only automation reaches them; Campaign
# I's missions 6-8 bring the real ones). Playing a mission whose next step offers a choice, the map
# shows its A/B sites and the choice box; until the mission's goals are met a site only says to
# finish it first. Once they are, MissionComplete's Next Mission opens the map, a site (on the map
# or in the box) asks before its mission starts, and the profile records the site picked. ----
{"method": "profile.set", "params": {"reached": ["dragon_legacy", "test_choices", "test_choices_kambara", "test_choices_tampadesa"]}}
{"method": "session.start_mission", "params": {"campaign": "test_choices", "mission": 0}}
{"method": "assert.eq", "params": {"query": "session.state", "path": "/campaign/campaign_id", "value": "test_choices"}}
{"method": "assert.eq", "params": {"query": "session.state", "path": "/campaign/mission_index", "value": 0}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "ui.click", "params": {"path": "Minimap/world_map"}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "world_map.state", "path": "/screen/campaign", "value": "test_choices"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "WorldMap/choice", "kind": "choice_box"}, "path": "/widgets/0/value", "value": {"title": "Next: Test: The Southern Shore", "subtitle": "Choose Hội Thủy or Vân Cảng", "mission": 1, "open": false}}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "WorldMap/Hội Thủy", "kind": "map_marker"}, "path": "/widgets/0/value", "value": {"kind": "choice_site", "site": "A", "mission": 1}}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "WorldMap/Vân Cảng", "kind": "map_marker"}, "path": "/widgets/0/value", "value": {"kind": "choice_site", "site": "B", "mission": 2}}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "WorldMap/choice/Vân Cảng", "kind": "choice_option"}, "path": "/widgets/0/value", "value": {"site": "B", "mission": 2}}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
# Mission 0 unfinished (its goal: a resident): a site says to finish it first.
{"method": "ui.click", "params": {"path": "WorldMap/Vân Cảng"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Finish Mission Popup/Finish Test: The First Seal first"}, "path": "/widgets/0"}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "screenshot", "params": {"path": "out/ui_world_map/choice_dailong_finish_first.png"}}
{"method": "ui.click", "params": {"path": "Finish Mission Popup/Ok"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Finish Mission Popup"}, "path": "/widgets", "value": []}}
{"method": "ui.click", "params": {"path": "WorldMap/bar/Return to the city"}}
# A resident meets the goal: MissionComplete's Next Mission opens the map, its choice open.
{"method": "cheats.set", "params": {"name": "instant_construction", "value": true}}
{"method": "cheats.set", "params": {"name": "ignore_tile_cost", "value": true}}
{"method": "world.place", "params": {"tile": "house0", "cell": [2, 2]}}
{"method": "time.fast_forward", "params": {"sim_secs": 1}}
{"method": "world.add_population", "params": {"cell": [2, 2], "count": 1}}
{"method": "wait.until", "params": {"query": "dialog.current", "path": "/current", "op": "eq", "value": "MissionComplete", "timeout_frames": 300}}
{"method": "assert.eq", "params": {"query": "session.state", "path": "/campaign/completed", "value": true}}
{"method": "ui.click", "params": {"path": "MissionComplete/Next Mission"}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "WorldMap"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "WorldMap/choice", "kind": "choice_box"}, "path": "/widgets/0/value/open", "value": true}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "screenshot", "params": {"path": "out/ui_world_map/choice_dailong.png"}}
# A site on the map asks first; Cancel keeps the city being played.
{"method": "ui.click", "params": {"path": "WorldMap/Hội Thủy"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Choose Site Popup/Settle at Hội Thủy?"}, "path": "/widgets/0"}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "ui.click", "params": {"path": "Choose Site Popup/Cancel"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Choose Site Popup"}, "path": "/widgets", "value": []}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "WorldMap"}}
{"method": "assert.eq", "params": {"query": "session.state", "path": "/campaign/mission_index", "value": 0}}
# Zoomed in, the box keeps to the view's corner, and its names still answer the pointer (ui.hover
# finds only widgets in view).
{"method": "world_map.set", "params": {"zoom": 2, "centre": [800, 300]}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "WorldMap/choice", "kind": "choice_box"}, "path": "/widgets/0"}}
{"method": "ui.hover", "params": {"path": "WorldMap/choice/Vân Cảng"}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "world_map.state", "path": "/screen/hovered", "value": "site:B"}}
{"method": "screenshot", "params": {"path": "out/ui_world_map/choice_dailong_zoomed.png"}}
# Site B, from the box, at 200% UI scale: the popup fits; Begin starts the B mission.
{"method": "config.set", "params": {"path": "/display/ui_scale_percent", "value": 200}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "ui.click", "params": {"path": "WorldMap/choice/Vân Cảng"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Choose Site Popup/Settle at Vân Cảng?"}, "path": "/widgets/0"}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "screenshot", "params": {"path": "out/ui_world_map/choice_dailong_popup_200.png"}}
{"method": "ui.click", "params": {"path": "Choose Site Popup/Begin the mission"}}
{"method": "wait.until", "params": {"query": "session.state", "path": "/campaign/mission_index", "op": "eq", "value": 2, "timeout_frames": 600}}
{"method": "assert.eq", "params": {"query": "session.state", "path": "/campaign/campaign_id", "value": "test_choices"}}
{"method": "assert.eq", "params": {"query": "session.state", "path": "/campaign/mission_id", "value": "southern_shore_b"}}
# Records keep the order they were made in: dragon_legacy's (started from Home above), then
# test_choices's (profile.set), so test_choices's is the second.
{"method": "assert.eq", "params": {"query": "profile.state", "path": "/profile/campaigns/1/id", "value": "test_choices"}}
{"method": "assert.eq", "params": {"query": "profile.state", "path": "/profile/campaigns/1/choices", "value": [{"step": 1, "site": "B"}]}}
{"method": "assert.eq", "params": {"query": "dialog.list", "path": "/dialogs/WorldMap", "value": false}}
{"method": "config.set", "params": {"path": "/display/ui_scale_percent", "value": 100}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 3}}
# Playing the B mission: Vân Cảng is the city being played, and no choice is left to make.
{"method": "ui.click", "params": {"path": "Minimap/world_map"}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "WorldMap/Vân Cảng", "kind": "map_marker"}, "path": "/widgets/0/value/current", "value": true}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "WorldMap/choice", "kind": "choice_box"}, "path": "/widgets", "value": []}}
{"method": "ui.click", "params": {"path": "WorldMap/bar/Return to the city"}}

