# Faith and festivals (docs/plans/faith.md): the game's patrons and their favour, the patrons'
# shrines and temples, picked in the build palette's submenu (a building whose variations the
# player picks) and placed as that patron's, favour drifting each month with the residents they
# reach, the minimap's Faith lens, the City book's Patrons tab, a festival planned on its Festivals
# tab and held at the start of its month (and one that falls short), and blessings and misfortunes
# set off by faith.event. From the repository root:
#   cargo run -p HeritageBuilder -- --fresh-profile --script crates/game/tests/scenarios/faith.jsonl
{"method": "time.fixed_dt", "params": {"dt": 0.016667}}
{"method": "session.new_map", "params": {"size": [40, 40]}}
{"method": "cheats.set", "params": {"name": "instant_construction", "value": true}}
{"method": "cheats.set", "params": {"name": "ignore_tile_cost", "value": true}}
{"method": "world.road", "params": {"from": [2, 20], "to": [38, 20]}}

# A new game is Đại Long's: its four patrons at the starting favour, favour and festivals on.
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/realm", "value": "dailong"}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/patrons/1/id", "value": "water_lord"}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/patrons/1/favour", "value": 50.0}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/patrons/1/mood", "value": "content"}}
{"method": "faith.set", "params": {"patron": "ancestors", "favour": 25, "festivals_enabled": false}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/patrons/3/mood", "value": "neglected"}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/festivals_enabled", "value": false}}

# The shrine opens its patrons as text buttons beside the Culture grid, within their panel; one
# picks the Water Lord's, and the shrine placed is his.
{"method": "ui.click", "params": {"path": "TilePaletteMenu/culture_and_religion"}}
{"method": "ui.click", "params": {"path": "Shrine"}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "TilePaletteVariationMenu: Shrine/", "fields": ["path"]}, "path": "/widgets/1/path", "value": "TilePaletteVariationMenu: Shrine/The Water Lord"}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "ui.click", "params": {"path": "TilePaletteVariationMenu: Shrine/The Water Lord"}}
{"method": "input.click", "params": {"cell": [12, 21]}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [12, 21]}, "path": "/patron", "value": "water_lord"}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [12, 21]}, "path": "/sections/0/rows/0/value", "value": "The Water Lord · Content"}}
{"method": "input.key", "params": {"key": "Escape"}}

# Escape closes the submenu and leaves the grid open; Escape again puts the grid away.
{"method": "ui.click", "params": {"path": "TilePaletteMenu/culture_and_religion"}}
{"method": "ui.click", "params": {"path": "Temple"}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "TilePaletteVariationMenu: Temple/The Ancestors"}, "path": "/widgets/0"}}
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "TilePaletteVariationMenu"}, "path": "/widgets", "value": []}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "TilePaletteChildMenu: culture_and_religion/Temple"}, "path": "/widgets/0"}}
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "TilePaletteChildMenu"}, "path": "/widgets", "value": []}}

# Automation names the variation; a shrine or temple placed without one is a patron's still.
{"method": "world.place", "params": {"tile": "temple", "cell": [20, 21], "variation": "ancestors"}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [21, 22]}, "path": "/patron", "value": "ancestors"}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [20, 21]}, "path": "/objects/0/variation_name", "value": "ancestors"}}
{"method": "world.place", "params": {"tile": "shrine", "cell": [30, 21]}}
{"method": "assert.exists", "params": {"query": "world.building_at", "args": {"cell": [30, 21]}, "path": "/patron"}}

# Each month favour moves a quarter of the way to its coverage: the Water Lord's shrine reaches the
# house beside it, the Ancestors' temple every house; no one tends the Mountain Lord, who falls.
{"method": "faith.set", "params": {"patron": "ancestors", "favour": 50, "festivals_enabled": true}}
{"method": "world.place", "params": {"tile": "house0", "cell": [13, 19]}}
{"method": "world.place", "params": {"tile": "house0", "cell": [24, 19]}}
{"method": "world.add_population", "params": {"cell": [13, 19], "count": 2}}
{"method": "world.add_population", "params": {"cell": [24, 19], "count": 2}}
{"method": "time.fast_forward", "params": {"sim_secs": 61}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/patrons/0/favour", "value": 37.5}}
{"method": "assert.gt", "params": {"query": "faith.state", "path": "/patrons/3/favour", "value": 50.0}}

# The Faith lens: shrines and temples in their patron's colour, houses by how many patrons reach
# them, and a legend of the patrons.
{"method": "ui.click", "params": {"path": "Minimap/lens_faith"}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "minimap.state", "path": "/lens_data/lens", "value": "faith"}}
{"method": "assert.eq", "params": {"query": "minimap.state", "path": "/lens_data/legend/1", "value": "The Water Lord"}}
{"method": "assert.ge", "params": {"query": "minimap.state", "path": "/lens_data/buildings", "value": 5}}
{"method": "ui.click", "params": {"path": "Minimap/lens_city"}}

# The City book's Heritage page, Patrons tab: a row per patron, within the page.
{"method": "dialog.open", "params": {"name": "CityManagement"}}
{"method": "ui.set", "params": {"path": "CityManagement/tab_bar", "value": "Heritage"}}
{"method": "ui.set", "params": {"path": "CityManagement/Heritage/Sections", "value": "Patrons"}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Patrons/patrons", "fields": ["value"]}, "path": "/widgets/0/value/patrons/1/id", "value": "water_lord"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Patrons/patrons", "fields": ["value"]}, "path": "/widgets/0/value/patrons/0/mood", "value": "Restless"}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "dialog.close"}

# Festivals. Favour holds meanwhile (no drift, no rolls), so the months skipped below bring no
# blessing or misfortune. The festival square is in the Culture grid, a fifth tile on a second row;
# the worker cheat staffs it and the granary, which holds the rice.
{"method": "faith.set", "params": {"favour_enabled": false, "patron": "water_lord", "favour": 40}}
{"method": "cheats.set", "params": {"name": "ignore_worker_requirements", "value": true}}
{"method": "ui.click", "params": {"path": "TilePaletteMenu/culture_and_religion"}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "ui.click", "params": {"path": "TilePaletteChildMenu: culture_and_religion/Festival Square"}}
{"method": "input.click", "params": {"cell": [26, 22]}}
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [26, 22]}, "path": "/kind", "value": "FestivalSquare"}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/squares/staffed", "value": 1}}
{"method": "world.place", "params": {"tile": "granary", "cell": [15, 21]}}
{"method": "world.place", "params": {"tile": "storage_yard", "cell": [6, 21]}}
{"method": "world.add_stock", "params": {"cell": [15, 21], "resources": {"Rice": 64}}}
{"method": "world.add_stock", "params": {"resources": {"Wine": 20}}}
{"method": "finance.set", "params": {"balance": 2000}}
{"method": "calendar.set", "params": {"year": 1, "month": 6}}

# The Heritage page's Festivals tab: the year's strip with this month, the list, and the planner on
# the next festival, the Floodwater offering in month 8. Hold in month 8 plans it at Grand (the
# button turns to Cancel), and the scale picked for a planned festival is the plan's.
{"method": "dialog.open", "params": {"name": "CityManagement"}}
{"method": "ui.set", "params": {"path": "CityManagement/tab_bar", "value": "Heritage"}}
{"method": "ui.set", "params": {"path": "CityManagement/Heritage/Sections", "value": "Festivals"}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Festivals/year", "fields": ["value"]}, "path": "/widgets/0/value/month", "value": 6}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Festivals/planner", "fields": ["value"]}, "path": "/widgets/0/value/festival", "value": "floodwater_offering"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Festivals/Scale", "kind": "step_selector", "fields": ["value"]}, "path": "/widgets/0/value", "value": "Grand"}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "ui.click", "params": {"path": "CityManagement/Heritage/Festivals/Hold in month 8"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/plan/festival", "value": "floodwater_offering"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Heritage/Festivals/Cancel"}, "path": "/widgets/0"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Festivals/Floodwater offering/row", "fields": ["value"]}, "path": "/widgets/0/value/state", "value": "planned"}}
{"method": "ui.set", "params": {"path": "CityManagement/Heritage/Festivals/Scale", "value": "Imperial"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/plan/scale", "value": "imperial"}}
{"method": "ui.set", "params": {"path": "CityManagement/Heritage/Festivals/Scale", "value": "Grand"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/plan/scale", "value": "grand"}}
{"method": "dialog.close"}

# At the start of month 8 it's held: 240 gold, 60 rice and 12 wine taken, the Water Lord's favour up
# by 18, the square dressed for the month, a Faith message, and the square's panel says so.
{"method": "time.fast_forward", "params": {"sim_secs": 121}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/festivals_held", "value": 1}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/log/0/scale", "value": "grand"}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/patrons/1/favour", "value": 58.0}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/festivals/2/state", "value": "held"}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/squares/festive", "value": 1}}
{"method": "assert.eq", "params": {"query": "finance.state", "path": "/this_year/categories/Festivals", "value": 240}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [15, 21]}, "path": "/stock/Rice", "value": 4}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "messages.state", "path": "/messages/0/kind", "value": "faith"}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [26, 22]}, "path": "/sections/1/rows/1/value", "value": "Floodwater offering, month 8"}}

# The Mid-autumn lanterns, planned for month 9, falls short of rice and pottery: not held, nothing
# taken, a warning, the plan dropped (it shows as this month's again); the square's dress comes off
# with the month.
{"method": "faith.plan", "params": {"festival": "mid_autumn_lanterns", "scale": "grand"}}
{"method": "time.fast_forward", "params": {"sim_secs": 61}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/festivals_held", "value": 1}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/festivals/3/state", "value": "now"}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/squares/festive", "value": 0}}
{"method": "assert.eq", "params": {"query": "finance.state", "path": "/this_year/categories/Festivals", "value": 240}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "messages.state", "path": "/messages/0/kind", "value": "warning"}}
{"method": "faith.set", "params": {"favour_enabled": true}}
{"method": "cheats.set", "params": {"name": "ignore_worker_requirements", "value": false}}
# The houses emptied over those months (no food): people move back in for what follows.
{"method": "world.add_population", "params": {"cell": [13, 19], "count": 2}}
{"method": "world.add_population", "params": {"cell": [24, 19], "count": 2}}

# Blessings and misfortunes, set off now by faith.event (the monthly rolls wait out each patron's
# six-month cooldown): the Ancestors' families bring gifts into the Offerings account, a Faith message
# in the log; the Village Guardian's rich harvest makes the farms produce half as fast again for three
# months; the Ancestors' fever, with risks on, makes a house sick, a Warning.
{"method": "faith.event", "params": {"patron": "ancestors", "event": "family_gifts"}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/patrons/3/months_since_event", "value": 0}}
{"method": "assert.eq", "params": {"query": "finance.state", "path": "/this_year/categories/Offerings", "value": 150}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "messages.state", "path": "/messages/0/kind", "value": "faith"}}
{"method": "world.place", "params": {"tile": "livestock_farm", "cell": [33, 23]}}
{"method": "faith.event", "params": {"patron": "village_guardian", "event": "rich_harvest"}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/production_scale/Farm", "value": 1.5}}
{"method": "assert.eq", "params": {"query": "faith.state", "path": "/effects/0/months_left", "value": 3}}
{"method": "faith.event", "params": {"patron": "ancestors", "event": "fever"}}
{"method": "assert.eq", "params": {"query": "risks.state", "path": "/sick", "value": 1}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "messages.state", "path": "/messages/0/kind", "value": "warning"}}
{"method": "faith.state"}
