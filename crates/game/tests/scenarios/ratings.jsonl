# The four ratings (docs/plans/ratings.md): a small city's ratings read from it, rising as a shrine
# and a theater go up; the HUD's rings and the City book's Ratings page and Overview in each realm,
# following ratings.set; then a hidden test mission's rating goals in the briefing, the rings, the
# goals panel (with its time limit) and the City book, met to finish it; then the mission lost to a
# year in debt: the failure screen, Escape's popup, a save that loads lost, Try again, a loss on
# Legitimacy in each realm's words and Return to the menu. Saves screenshots to out/ratings/. From
# the repository root:
#   cargo run -p HeritageBuilder -- --fresh-profile --default-configs --window-size 1920x1080 --script crates/game/tests/scenarios/ratings.jsonl
{"method": "time.fixed_dt", "params": {"dt": 0.016667}}
{"method": "session.new_map", "params": {"size": [24, 24]}}
{"method": "cheats.set", "params": {"name": "instant_construction", "value": true}}
{"method": "cheats.set", "params": {"name": "ignore_worker_requirements", "value": true}}
{"method": "cheats.set", "params": {"name": "no_city_risks", "value": true}}
{"method": "cheats.set", "params": {"name": "ignore_tile_cost", "value": true}}
{"method": "sim.pause"}

# ---- A new map is rated at once ----
{"method": "assert.exists", "params": {"query": "ratings.state", "path": "/rated_month"}}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/realm", "value": "dailong"}}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/legitimacy/name", "value": "The Mandate"}}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/legitimacy/driver_values/fair_taxes", "value": 10}}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/fails_on/debt", "value": false}}

# ---- Two houses with people; then a shrine and a theater raise Culture ----
{"method": "finance.set", "params": {"balance": 1000}}
{"method": "world.road", "params": {"from": [3, 10], "to": [20, 10]}}
{"method": "world.place", "params": {"tile": "house0", "cell": [8, 9]}}
{"method": "world.place", "params": {"tile": "house0", "cell": [13, 9]}}
{"method": "world.add_population", "params": {"cell": [8, 9], "count": 2}}
{"method": "world.add_population", "params": {"cell": [13, 9], "count": 2}}
{"method": "ratings.recompute"}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/culture/driver_values/temples", "value": 0}}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/culture/driver_values/theatre", "value": 0}}
{"method": "world.place", "params": {"tile": "shrine", "cell": [11, 9]}}
{"method": "ratings.recompute"}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/culture/driver_values/temples", "value": 35}}
{"method": "world.place", "params": {"tile": "theater", "cell": [15, 11]}}
{"method": "ratings.recompute"}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/culture/driver_values/theatre", "value": 25}}
# 35 + 25, less 2 for a year without a festival.
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/culture/driver_values/no_festival", "value": -2}}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/culture/value", "value": 58}}
# Harsh taxes are unfair.
{"method": "finance.set", "params": {"tax_level": "Harsh"}}
{"method": "ratings.recompute"}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/legitimacy/driver_values/fair_taxes", "value": -15}}
{"method": "finance.set", "params": {"tax_level": "Normal"}}
{"method": "ratings.recompute"}

# ---- The HUD's rings follow the ratings ----
{"method": "ratings.set", "params": {"rating": "security", "value": 42}}
{"method": "input.move", "params": {"park": true}}
# The widget registry is off until a ui command turns it on.
{"method": "ui.tree", "params": {"fields": ["path"]}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "TopBar/ratings", "kind": "canvas"}, "path": "/widgets/0/value/rated", "value": true}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "TopBar/ratings", "kind": "canvas"}, "path": "/widgets/0/value/values/2", "value": 42}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "TopBar/ratings", "kind": "canvas"}, "path": "/widgets/0/value/names/3", "value": "The Mandate"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "TopBar/ratings", "kind": "canvas"}, "path": "/widgets/0/value/goals", "value": [null, null, null, null]}}
{"method": "ui.hover", "params": {"path": "TopBar/ratings"}}
{"method": "wait.frames", "params": {"frames": 30}}
{"method": "screenshot", "params": {"path": "out/ratings/hud-dailong.png"}}
{"method": "input.move", "params": {"park": true}}

# ---- The City book's Ratings page, after Finances ----
{"method": "ui.click", "params": {"path": "TopBar/City book"}}
{"method": "input.move", "params": {"park": true}}
{"method": "ui.set", "params": {"path": "CityManagement/tab_bar", "value": "Ratings"}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/tab_bar", "kind": "tab_bar"}, "path": "/widgets/0/value", "value": "Ratings"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"kind": "tab", "fields": ["path", "value"]}, "path": "/widgets/4", "value": {"path": "CityManagement/Ratings", "value": true}}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/title", "kind": "canvas"}, "path": "/widgets/0/value/note", "value": "What raises and lowers each rating"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/security", "kind": "canvas"}, "path": "/widgets/0/value/value", "value": 42}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/culture", "kind": "canvas"}, "path": "/widgets/0/value/drivers/0", "value": {"name": "Temples and shrines", "value": 35}}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/culture", "kind": "canvas"}, "path": "/widgets/0/value/drivers/1", "value": {"name": "Theatre", "value": 25}}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/legitimacy", "kind": "canvas"}, "path": "/widgets/0/value/name", "value": "The Mandate"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/legitimacy", "kind": "canvas"}, "path": "/widgets/0/value/met", "value": false}}
{"method": "screenshot", "params": {"path": "out/ratings/book-dailong.png"}}
# A rating set while the book is open: it reads the ratings again.
{"method": "ratings.set", "params": {"rating": "prosperity", "value": 77}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/prosperity", "kind": "canvas"}, "path": "/widgets/0/value/value", "value": 77}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/tab_bar", "kind": "tab_bar"}, "path": "/widgets/0/value", "value": "Ratings"}}
{"method": "ratings.recompute"}
{"method": "wait.frames", "params": {"frames": 3}}

# ---- Kambara's and Tampadesa's words for them ----
{"method": "ui.realm", "params": {"realm": "kambara"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/legitimacy", "kind": "canvas"}, "path": "/widgets/0/value/name", "value": "Divine favour"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/culture", "kind": "canvas"}, "path": "/widgets/0/value/drivers/1/name", "value": "Dance halls"}}
{"method": "screenshot", "params": {"path": "out/ratings/book-kambara.png"}}
{"method": "ui.realm", "params": {"realm": "tampadesa"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/legitimacy", "kind": "canvas"}, "path": "/widgets/0/value/name", "value": "Merit"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/culture", "kind": "canvas"}, "path": "/widgets/0/value/drivers/1/name", "value": "Pwè theatre"}}
{"method": "screenshot", "params": {"path": "out/ratings/book-tampadesa.png"}}
{"method": "ui.realm", "params": {"realm": "auto"}}
{"method": "wait.frames", "params": {"frames": 3}}

# ---- The Overview's ratings card ----
{"method": "ui.set", "params": {"path": "CityManagement/tab_bar", "value": "Overview"}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Overview/standing", "kind": "canvas"}, "path": "/widgets/0/value/ratings/rated", "value": true}}
{"method": "ratings.set", "params": {"rating": "culture", "value": 64}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Overview/standing", "kind": "canvas"}, "path": "/widgets/0/value/ratings/values/1", "value": 64}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Overview/standing", "kind": "canvas"}, "path": "/widgets/0/value/ratings/goals", "value": [null, null, null, null]}}
{"method": "screenshot", "params": {"path": "out/ratings/overview-dailong.png"}}
{"method": "dialog.close"}

# ---- A month's start reads them again ----
# The game hasn't run yet: a month and a step take it past the month's end (the calendar moves in the
# world's half-second steps).
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/culture/value", "value": 64}}
{"method": "time.fast_forward", "params": {"sim_secs": 61, "resume": true}}
{"method": "sim.pause"}
{"method": "assert.ne", "params": {"query": "ratings.state", "path": "/ratings/culture/value", "value": 64}}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/culture/driver_values/temples", "value": 35}}

# ---- A mission's goals (Phase 2): the hidden test campaign's Culture 60, the Mandate 20 and a house at
# level 1, within two years ----
{"method": "session.start_mission", "params": {"campaign": "test_goals"}}
{"method": "wait.until", "params": {"query": "dialog.current", "path": "/current", "op": "eq", "value": "MissionBriefing", "timeout_frames": 60}}
# The briefing lists the goals in the realm's words, and the time limit.
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionBriefing/goals", "kind": "table"}, "path": "/widgets/0/value/rows", "value": [["Culture", "60"], ["The Mandate", "20"], ["Houses at level 1 or above", "1"], ["Time limit", "2 years"]]}}
{"method": "input.move", "params": {"park": true}}
{"method": "screenshot", "params": {"path": "out/ratings/briefing-goals.png"}}
{"method": "ui.click", "params": {"path": "MissionBriefing/Begin"}}
{"method": "sim.pause"}
{"method": "input.move", "params": {"park": true}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/time_limit_months", "value": 24}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/months_left", "value": 24}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/goals/0/def", "value": {"Rating": {"rating": "culture", "min": 60}}}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/goals/0/met", "value": false}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/goals/2/goal", "value": "Houses at level 1 or above"}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/goals/2/met", "value": true}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/all_met", "value": false}}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/ratings/culture/goal", "value": 60}}
# Its distinctions (Phase 4), open while the mission goes on.
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/distinctions/0", "value": {"id": "no_debt", "def": "NoDebt", "distinction": "Never fall into debt", "state": "open"}}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/distinctions/1/distinction", "value": "Culture 80 or higher"}}
# The rings tick the goals; the goals panel lists them and the months left.
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "TopBar/ratings", "kind": "canvas"}, "path": "/widgets/0/value/goals", "value": [null, 60, null, 20]}}
{"method": "ui.click", "params": {"path": "TopBar/Goals"}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Goals/goals", "kind": "canvas"}, "path": "/widgets/0/value/1/goal", "value": "The Mandate"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Goals/time_left", "kind": "canvas"}, "path": "/widgets/0/value", "value": {"months_left": 24, "limit": 24}}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "screenshot", "params": {"path": "out/ratings/goals-panel.png"}}
# The City book's cards say what's left to each goal.
{"method": "ui.click", "params": {"path": "TopBar/City book"}}
{"method": "input.move", "params": {"park": true}}
{"method": "ui.set", "params": {"path": "CityManagement/tab_bar", "value": "Ratings"}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/culture", "kind": "canvas"}, "path": "/widgets/0/value/goal", "value": 60}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/culture", "kind": "canvas"}, "path": "/widgets/0/value/met", "value": false}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CityManagement/Ratings/legitimacy", "kind": "canvas"}, "path": "/widgets/0/value/goal", "value": 20}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "screenshot", "params": {"path": "out/ratings/book-goals.png"}}
{"method": "dialog.close"}
# A month on, a month less.
{"method": "time.fast_forward", "params": {"sim_secs": 61, "resume": true}}
{"method": "sim.pause"}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/months_elapsed", "value": 1}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/months_left", "value": 23}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Goals/time_left", "kind": "canvas"}, "path": "/widgets/0/value/months_left", "value": 23}}
# Culture 65 (and the Mandate kept at 30) meets the goals: the next step finishes the mission.
{"method": "ratings.set", "params": {"rating": "culture", "value": 65}}
{"method": "ratings.set", "params": {"rating": "legitimacy", "value": 30}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/all_met", "value": true}}
{"method": "sim.resume"}
{"method": "wait.until", "params": {"query": "dialog.current", "path": "/current", "op": "eq", "value": "MissionComplete", "timeout_frames": 120}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/completed", "value": true}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionComplete/panel/goals", "kind": "table"}, "path": "/widgets/0/value/rows/0", "value": ["Culture", "60", "65"]}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionComplete/panel/goals", "kind": "table"}, "path": "/widgets/0/value/status", "value": ["done", "done", "done"]}}
# Never in debt earned, Culture 80 missed; the ratings' bars as set.
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionComplete/panel/distinctions", "kind": "table"}, "path": "/widgets/0/value/status", "value": ["done", "failed"]}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/distinctions/1/state", "value": "missed"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionComplete/panel/ratings", "kind": "canvas"}, "path": "/widgets/0/value/values", "value": [15, 65, 30, 30]}}
{"method": "input.move", "params": {"park": true}}
{"method": "screenshot", "params": {"path": "out/ratings/debrief-goals.png"}}
{"method": "ui.click", "params": {"path": "MissionComplete/panel/Keep playing"}}

# ---- Failure (Phase 3): the test mission in debt for its twelfth month ----
{"method": "session.start_mission", "params": {"campaign": "test_goals"}}
{"method": "wait.until", "params": {"query": "dialog.current", "path": "/current", "op": "eq", "value": "MissionBriefing", "timeout_frames": 60}}
{"method": "ui.click", "params": {"path": "MissionBriefing/Begin"}}
{"method": "sim.pause"}
{"method": "input.move", "params": {"park": true}}
# A month's end in debt spoils never in debt: out of reach for good, kept with the game.
{"method": "finance.set", "params": {"balance": -500, "months_in_debt": 1}}
{"method": "time.fast_forward", "params": {"sim_secs": 61, "resume": true}}
{"method": "sim.pause"}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/distinctions/0/state", "value": "spoiled"}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/distinctions/1/state", "value": "open"}}
{"method": "assert.eq", "params": {"query": "ratings.state", "path": "/spoiled", "value": ["no_debt"]}}
# Its twelfth month in debt: run to just before the month's end, then play into it (the failure screen
# pauses the game).
{"method": "finance.set", "params": {"balance": -500, "months_in_debt": 11}}
{"method": "time.fast_forward", "params": {"sim_secs": 58.5, "resume": true}}
{"method": "sim.resume"}
{"method": "wait.until", "params": {"query": "dialog.current", "path": "/current", "op": "eq", "value": "MissionFailed", "timeout_frames": 300}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/failure", "value": "debt"}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": true}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionFailed/panel/kicker"}, "path": "/widgets/0/value", "value": "MISSION 1 FAILED"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionFailed/panel/reason"}, "path": "/widgets/0/value", "value": "The treasury has failed the city"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionFailed/panel/why"}, "path": "/widgets/0/value", "value": "The treasury stayed in debt for 12 months in a row."}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionFailed/panel/goals", "kind": "table"}, "path": "/widgets/0/value/rows/0/0", "value": "Culture"}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "input.move", "params": {"park": true}}
{"method": "screenshot", "params": {"path": "out/ratings/failed-debt.png"}}
# Escape asks before leaving; Cancel stays.
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Return to Menu Popup/Cancel"}, "path": "/widgets/0"}}
{"method": "screenshot", "params": {"path": "out/ratings/failed-popup.png"}}
{"method": "ui.click", "params": {"path": "Return to Menu Popup/Cancel"}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "MissionFailed"}}
# A save of the lost game loads lost, its failure screen again.
{"method": "session.save", "params": {"name": "ratings_failed"}}
{"method": "wait.until", "params": {"query": "session.save_info", "args": {"name": "ratings_failed"}, "path": "/has_thumbnail", "op": "eq", "value": true, "timeout_frames": 60}}
{"method": "session.load_save", "params": {"name": "ratings_failed"}}
{"method": "wait.until", "params": {"query": "dialog.current", "path": "/current", "op": "eq", "value": "MissionFailed", "timeout_frames": 60}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/failure", "value": "debt"}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": true}}
{"method": "session.delete_save", "params": {"name": "ratings_failed"}}
# Try again: the mission from its start, its briefing first, out of debt.
{"method": "ui.click", "params": {"path": "MissionFailed/panel/Try again"}}
{"method": "wait.until", "params": {"query": "dialog.current", "path": "/current", "op": "eq", "value": "MissionBriefing", "timeout_frames": 60}}
{"method": "assert.eq", "params": {"query": "goals.state", "path": "/months_elapsed", "value": 0}}
{"method": "assert.eq", "params": {"query": "finance.state", "path": "/months_in_debt", "value": 0}}
{"method": "ui.click", "params": {"path": "MissionBriefing/Begin"}}
{"method": "sim.pause"}
# Lost on Legitimacy, in each realm's words; then Return to the menu.
{"method": "campaign.fail", "params": {"reason": "legitimacy"}}
{"method": "wait.until", "params": {"query": "dialog.current", "path": "/current", "op": "eq", "value": "MissionFailed", "timeout_frames": 30}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionFailed/panel/reason"}, "path": "/widgets/0/value", "value": "The court has recalled you"}}
{"method": "ui.realm", "params": {"realm": "tampadesa"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionFailed/panel/reason"}, "path": "/widgets/0/value", "value": "The sangha turns away"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "MissionFailed/panel/why"}, "path": "/widgets/0/value", "value": "Merit stayed below 10 for 12 months."}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "input.move", "params": {"park": true}}
{"method": "screenshot", "params": {"path": "out/ratings/failed-tampadesa.png"}}
{"method": "ui.realm", "params": {"realm": "auto"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "ui.click", "params": {"path": "MissionFailed/panel/Return to the menu"}}
{"method": "wait.until", "params": {"query": "session.state", "path": "/menus_mode", "op": "eq", "value": "Home", "timeout_frames": 60}}
