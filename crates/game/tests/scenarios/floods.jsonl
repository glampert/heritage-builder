{"method": "assert.exists", "params": {"query": "minimap.state", "path": "/lenses/5"}}
{"method": "assert.eq", "params": {"query": "minimap.state", "path": "/lenses/5", "value": "flood"}}
{"method": "minimap.set", "params": {"open": true, "lens": "flood"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "minimap.state", "path": "/lens_data/lens", "value": "flood"}}
{"method": "assert.gt", "params": {"query": "minimap.state", "path": "/lens_data/heat_cells", "value": 100}}
{"method": "assert.gt", "params": {"query": "minimap.state", "path": "/lens_data/buildings", "value": 3}}
