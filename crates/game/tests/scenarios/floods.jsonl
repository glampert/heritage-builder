# The river's flood (docs/plans/seasons-floods.md, Phases 2 to 4 and 6): a river laid on a blank map, floods
# turned on, houses and a farmstead with its fields by the river; the wet season's message, the Flood
# lens before the flood, the flood in month 7 (the cells under water, the damage, the crops lost, its
# Warning, the lens, a flooded field's and cell's panels), the water staying through month 8 and
# going in month 9 (its message, the fields sown again); a flood now and the water going; a dyke
# from the Roads grid holding a flood back, then a worn section breaching; a sluice gate from the
# Food grid beside the dyke and a canal from its outlet (dry until a canal brings the river to the
# dyke's foot; the gate's, a canal's and a field's panels, the fields it waters, the silt it lets
# in, the Fertility lens, the dry season's sowing); and floods turned off. From the repository root:
#   cargo run -p HeritageBuilder -- --script crates/game/tests/scenarios/floods.jsonl --default-configs --fresh-profile
{"method": "time.fixed_dt", "params": {"dt": 0.016667}}
{"method": "session.new_map", "params": {"size": [40, 40]}}
{"method": "cheats.set", "params": {"name": "instant_construction", "value": true}}
{"method": "cheats.set", "params": {"name": "ignore_tile_cost", "value": true}}
{"method": "cheats.set", "params": {"name": "ignore_worker_requirements", "value": true}}
# A river two cells wide along x 20 and 21 (the cells past the playable area are refused).
{"method": "world.place_area", "params": {"tile": "water", "from": [20, 0], "to": [21, 39]}}
{"method": "floods.set", "params": {"enabled": true}}
{"method": "assert.eq", "params": {"query": "floods.state", "path": "/enabled", "value": true}}
{"method": "assert.exists", "params": {"query": "floods.state", "path": "/sources/0"}}
{"method": "assert.gt", "params": {"query": "floods.state", "path": "/ordinary_reach", "value": 100}}
{"method": "assert.eq", "params": {"query": "floods.state", "args": {"cell": [18, 20]}, "path": "/fertility/at/fertility", "value": 70}}
{"method": "assert.eq", "params": {"query": "floods.state", "args": {"cell": [8, 20]}, "path": "/fertility/at/fertility", "value": 40}}
# Houses by the river (within any flood's reach) and far from it; a farmstead between, its fields
# laid on both sides of it (fields are listed in row order: the second, (17, 21), is by the river).
{"method": "world.road", "params": {"from": [11, 14], "to": [11, 30]}}
{"method": "world.place", "params": {"tile": "house0", "cell": [17, 16]}}
{"method": "world.place", "params": {"tile": "house0", "cell": [9, 16]}}
{"method": "world.place", "params": {"tile": "farmstead", "cell": [14, 22]}}
{"method": "world.place_area", "params": {"tile": "rice_field", "from": [17, 21], "to": [19, 24]}}
{"method": "world.place_area", "params": {"tile": "rice_field", "from": [12, 21], "to": [12, 24]}}
{"method": "assert.eq", "params": {"query": "farms.state", "path": "/farmsteads/0/fields", "value": 16}}
{"method": "camera.teleport", "params": {"cell": [17, 21]}}
{"method": "camera.zoom", "params": {"zoom": 2}}
# The widget registry on, for ui.layout_issues.
{"method": "ui.tree", "params": {"filter": "Minimap"}}
# The wet season begins in month 5: the river is rising, and the fields are sown.
{"method": "calendar.set", "params": {"year": 1, "month": 4}}
{"method": "time.fast_forward", "params": {"sim_secs": 61}}
{"method": "wait.frames", "params": {"frames": 2}}
