{"method": "time.fast_forward", "params": {"sim_secs": 60}}
{"method": "assert.eq", "params": {"query": "floods.state", "path": "/flood/months_left", "value": 1}}
{"method": "time.fast_forward", "params": {"sim_secs": 60}}
