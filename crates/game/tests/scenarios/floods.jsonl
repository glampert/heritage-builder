{"method": "assert.eq", "params": {"query": "messages.state", "path": "/messages/0/text", "value": "The river is rising: the wet season has begun."}}
{"method": "assert.eq", "params": {"query": "farms.state", "path": "/fields/1/stage", "value": "sown"}}
