{"method": "input.move", "params": {"park": true}}
{"method": "screenshot", "params": {"path": "out/floods/fertility_lens.png"}}
# The dry season (month 11): the fields water reaches are sown, through the gate or from the river;
# the one joined to nothing isn't.
{"method": "calendar.set", "params": {"year": 1, "month": 10}}
{"method": "time.fast_forward", "params": {"sim_secs": 61}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "farms.state", "path": "/fields/0/stage", "value": "fallow"}}
{"method": "assert.eq", "params": {"query": "farms.state", "path": "/fields/1/stage", "value": "sown"}}
{"method": "assert.eq", "params": {"query": "farms.state", "path": "/fields/2/stage", "value": "sown"}}
# Floods off: the Flood lens isn't offered, and the minimap goes back to the city.
{"method": "minimap.set", "params": {"lens": "flood"}}
{"method": "floods.set", "params": {"enabled": false}}
{"method": "wait.frames", "params": {"frames": 70}}
{"method": "assert.eq", "params": {"query": "minimap.state", "path": "/lens", "value": "city"}}
{"method": "assert.eq", "params": {"query": "minimap.state", "path": "/lenses", "value": ["city", "sectors", "water", "risk", "faith"]}}
