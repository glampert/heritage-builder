# Walks every screen of the game's UI, retail and developer, and at each one lists the widgets
# (ui.tree, without rects) and compares a screenshot with a golden image. For checking UI changes
# that should leave the UI as it was (paths, kinds, values) and for reviewing how it looks. Goldens
# depend on the machine and render backend, so keep one directory per backend:
#   cargo run -p HeritageBuilder -- --script crates/game/tests/scenarios/ui_snapshot.jsonl \
#     --window-size 1280x720 --seed 1 --render-api OpenGl --golden-dir out/baseline/opengl --update-goldens
# Then, to compare against them (screenshots and -diff.png files go to out/ui_snapshot/):
#   cargo run -p HeritageBuilder -- --script crates/game/tests/scenarios/ui_snapshot.jsonl \
#     --window-size 1280x720 --seed 1 --render-api OpenGl --golden-dir out/baseline/opengl --script-continue-on-error
# The Load Game and Save Game lists show the local saves/, so keep it unchanged between runs. Not run
# in CI: there are no goldens there.
{"method": "time.fixed_dt", "params": {"dt": 0.016667}}

# ---- Home menu and its dialogs ----
{"method": "assert.eq", "params": {"query": "session.state", "path": "/menus_mode", "value": "Home"}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "ui.tree", "params": {"fields": ["path", "kind", "enabled", "value"]}}
{"method": "assert.image", "params": {"golden": "home.png", "path": "out/ui_snapshot/home.png"}}
{"method": "ui.hover", "params": {"path": "Home/New Game"}}
