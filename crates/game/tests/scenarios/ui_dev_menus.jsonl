# Drives the developer editor's ImGui menus (Ctrl+/) through the widget registry: the tile palette,
# the menu bar, the minimap's debug panel and the tile inspector and its panels. From the repository root:
#   cargo run -p HeritageBuilder -- --script crates/game/tests/scenarios/ui_dev_menus.jsonl
{"method": "time.fixed_dt", "params": {"dt": 0.016667}}
{"method": "session.new_map", "params": {"size": [16, 16]}}
{"method": "menus.mode", "params": {"mode": "DevEditor"}}
# Tile palette: select a tile by name (most of the palette is scrolled out of view), place it, undo.
{"method": "ui.set", "params": {"path": "Tile Selection", "value": "Small Well"}}
{"method": "input.click", "params": {"cell": [8, 8]}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [8, 8]}, "path": "/objects/0/name", "value": "small_well"}}
{"method": "ui.click", "params": {"path": "Tile Selection/Tools/Undo"}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [8, 8]}, "path": "/objects", "value": []}}
# Menu bar: a menu's items are listed while it's open.
{"method": "ui.click", "params": {"path": "Debug"}}
{"method": "ui.set", "params": {"path": "Debug/Draw grid", "value": true}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Debug/Draw grid"}, "path": "/widgets/0/value", "value": true}}
{"method": "ui.click", "params": {"path": "Game"}}
{"method": "ui.click", "params": {"path": "Game/Pause"}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": true}}
{"method": "ui.click", "params": {"path": "Game/Resume"}}
{"method": "ui.click", "params": {"path": "Game"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Game/"}, "path": "/widgets", "value": []}}
# Minimap debug panel: open it, set a value, close it with its title bar button.
{"method": "ui.click", "params": {"path": "Minimap/debug"}}
{"method": "ui.set", "params": {"path": "Minimap Debug/Zoom", "value": 1.5}}
{"method": "ui.click", "params": {"path": "Minimap Debug/Close"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Minimap Debug"}, "path": "/widgets", "value": []}}
# Tile inspector: a click on the map inspects the tile there.
{"method": "input.click", "params": {"cell": [8, 8]}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"kind": "window", "filter": "Tile Inspector"}, "path": "/widgets/0/value/cell", "value": [8, 8]}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Close"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Tile Inspector"}, "path": "/widgets", "value": []}}
# Its panels: open a house's Building and Upgrade sections and set its level.
{"method": "world.place", "params": {"tile": "house0", "cell": [10, 10]}}
{"method": "input.click", "params": {"cell": [10, 10]}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Building"}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Building/Upgrade"}}
{"method": "ui.set", "params": {"path": "Tile Inspector/Building/Upgrade/Level", "value": 1}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [10, 10]}, "path": "/name", "value": "House Level 1"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"kind": "window", "filter": "Tile Inspector"}, "path": "/widgets/0/value/tile", "value": "house1"}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Close"}}
# Debug windows: World Debug's tabs ("Tax/Treasury" is the tab's label; its path segment is "Tax∕Treasury").
{"method": "ui.click", "params": {"path": "Debug"}}
{"method": "ui.set", "params": {"path": "Debug/Show Game World Debug", "value": true}}
{"method": "ui.click", "params": {"path": "Tax/Treasury"}}
{"method": "ui.set", "params": {"path": "World Debug/Tax∕Treasury/Gold Units", "value": 250}}
{"method": "ui.click", "params": {"path": "World Debug/Tax∕Treasury/Give Gold"}}
{"method": "assert.eq", "params": {"query": "world.stats", "path": "/treasury/gold", "value": 350}}
{"method": "ui.click", "params": {"path": "World Debug/Close"}}
# The log viewer's console: ui.set fills it in while it has keyboard focus, Enter runs it; or type it.
{"method": "ui.click", "params": {"path": "Debug"}}
{"method": "ui.set", "params": {"path": "Debug/Show Log Viewer Window", "value": true}}
{"method": "ui.set", "params": {"path": "Log Viewer/Console", "value": "sim.pause"}}
{"method": "input.key", "params": {"key": "Enter"}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": true}}
{"method": "input.type", "params": {"text": "sim.resume"}}
{"method": "input.key", "params": {"key": "Enter"}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": false}}
{"method": "ui.click", "params": {"path": "Log Viewer/Close"}}
{"method": "input.move", "params": {"park": true}}
{"method": "screenshot", "params": {"path": "out/ui_dev_menus.png", "scale": "points"}}
