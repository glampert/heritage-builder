# Drives the developer editor's menus (Ctrl+/) through the widget registry: the tile palette,
# the menu bar, the minimap's debug panel, the tile inspector and its panels, the sample menus'
# 9-slice panels, and the widget samples (tabs, toggles, step selectors, menu items, list rows and
# the data widgets). From the repository root:
#   cargo run -p HeritageBuilder -- --script crates/game/tests/scenarios/ui_dev_menus.jsonl
{"method": "time.fixed_dt", "params": {"dt": 0.016667}}
{"method": "session.new_map", "params": {"size": [16, 16]}}
{"method": "menus.mode", "params": {"mode": "DevEditor"}}
# Tile palette: select a tile by name (most of the palette is scrolled out of view), place it, undo.
{"method": "ui.set", "params": {"path": "Tile Selection", "value": "Small Well"}}
{"method": "input.click", "params": {"cell": [8, 8]}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [8, 8]}, "path": "/objects/0/name", "value": "small_well"}}
{"method": "ui.click", "params": {"path": "Tile Selection/Tools/Undo"}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [8, 8]}, "path": "/objects", "value": []}}
# Menu bar: a menu's items are listed while it's open.
{"method": "ui.click", "params": {"path": "Debug"}}
{"method": "ui.set", "params": {"path": "Debug/Draw grid", "value": true}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Debug/Draw grid"}, "path": "/widgets/0/value", "value": true}}
{"method": "ui.click", "params": {"path": "Game"}}
{"method": "ui.click", "params": {"path": "Game/Pause"}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": true}}
{"method": "ui.click", "params": {"path": "Game/Resume"}}
{"method": "ui.click", "params": {"path": "Game"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Game/"}, "path": "/widgets", "value": []}}
# Minimap debug panel: open it, set a value, close it with its title bar button.
{"method": "ui.click", "params": {"path": "Minimap/debug"}}
{"method": "ui.set", "params": {"path": "Minimap Debug/Zoom", "value": 1.5}}
{"method": "ui.click", "params": {"path": "Minimap Debug/Close"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Minimap Debug"}, "path": "/widgets", "value": []}}
# Tile inspector: a click on the map inspects the tile there.
{"method": "input.click", "params": {"cell": [8, 8]}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"kind": "window", "filter": "Tile Inspector"}, "path": "/widgets/0/value/cell", "value": [8, 8]}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Close"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Tile Inspector"}, "path": "/widgets", "value": []}}
# Its panels: open a house's Building and Upgrade sections and set its level.
{"method": "world.place", "params": {"tile": "house0", "cell": [10, 10]}}
{"method": "input.click", "params": {"cell": [10, 10]}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Building"}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Building/Upgrade"}}
{"method": "ui.set", "params": {"path": "Tile Inspector/Building/Upgrade/Level", "value": 1}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [10, 10]}, "path": "/name", "value": "House Level 1"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"kind": "window", "filter": "Tile Inspector"}, "path": "/widgets/0/value/tile", "value": "house1"}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Close"}}
# Its Risks section: set one house on fire, and collapse another. Each building has its own
# inspector window, so its headers start closed; close one before clicking a house it may cover.
# The collapse waits for the next frame.
{"method": "cheats.set", "params": {"name": "instant_construction", "value": true}}
{"method": "world.place", "params": {"tile": "house0", "cell": [3, 12]}}
{"method": "world.place", "params": {"tile": "house0", "cell": [5, 12]}}
{"method": "cheats.set", "params": {"name": "instant_construction", "value": false}}
{"method": "input.click", "params": {"cell": [3, 12]}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Building"}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Building/Risks"}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Building/Risks/Set On Fire"}}
{"method": "assert.exists", "params": {"query": "world.building_at", "args": {"cell": [3, 12]}, "path": "/risks/burning"}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Close"}}
{"method": "input.click", "params": {"cell": [5, 12]}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Building"}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Building/Risks"}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Building/Risks/Collapse"}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [5, 12]}, "path": "/objects/0/name", "value": "rubble"}}
{"method": "ui.click", "params": {"path": "Tile Inspector/Close"}}
# Debug windows: World Debug's tabs ("Tax/Treasury" is the tab's label; its path segment is "Tax∕Treasury").
{"method": "ui.click", "params": {"path": "Debug"}}
{"method": "ui.set", "params": {"path": "Debug/Show Game World Debug", "value": true}}
{"method": "ui.click", "params": {"path": "Tax/Treasury"}}
{"method": "ui.set", "params": {"path": "World Debug/Tax∕Treasury/Gold Units", "value": 250}}
{"method": "ui.click", "params": {"path": "World Debug/Tax∕Treasury/Give Gold"}}
{"method": "assert.eq", "params": {"query": "world.stats", "path": "/treasury/gold", "value": 350}}
{"method": "ui.click", "params": {"path": "World Debug/Close"}}
# The sample menus. Sample Menu 3 shows 9-slice panels: its background, framed buttons (one
# disabled) with a tooltip on a panel, a popup on a panel, and panels drawn with the painter.
{"method": "ui.click", "params": {"path": "Debug"}}
{"method": "ui.set", "params": {"path": "Debug/Show Sample Menus", "value": true}}
{"method": "ui.hover", "params": {"path": "Sample Menu 3/Framed Button"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 3/Disabled Framed Button"}, "path": "/widgets/0/enabled", "value": false}}
{"method": "ui.click", "params": {"path": "Sample Menu 3/Open Panel Popup"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Panel Popup/Ok", "kind": "text_button"}, "path": "/widgets/0"}}
{"method": "ui.click", "params": {"path": "Panel Popup/Ok"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Panel Popup/"}, "path": "/widgets", "value": []}}
{"method": "ui.click", "params": {"path": "Debug"}}
{"method": "ui.set", "params": {"path": "Debug/Show Sample Menus", "value": false}}
{"method": "ui.click", "params": {"path": "Debug"}}
# The widget samples: Sample Menu 4 (controls) and 5 (data), the realm UI's widgets.
{"method": "ui.click", "params": {"path": "Debug"}}
{"method": "ui.set", "params": {"path": "Debug/Show Widget Samples", "value": true}}
# Tabs: a click on a tab, or ui.set on the bar by label or index; the selected tab names its contents' paths.
{"method": "ui.click", "params": {"path": "Sample Menu 4/Sound"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/tab_bar"}, "path": "/widgets/0/value", "value": "Sound"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/Sound/Music"}, "path": "/widgets/0/kind", "value": "toggle"}}
{"method": "ui.set", "params": {"path": "Sample Menu 4/tab_bar", "value": 0}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/Game", "kind": "tab"}, "path": "/widgets/0/value", "value": true}}
# Toggles: a click flips one, ui.set sets it.
{"method": "ui.click", "params": {"path": "Sample Menu 4/Game/Edge scrolling"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/Game/Edge scrolling"}, "path": "/widgets/0/value", "value": false}}
{"method": "ui.set", "params": {"path": "Sample Menu 4/Game/Smooth zoom", "value": true}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/Game/Smooth zoom"}, "path": "/widgets/0/value", "value": true}}
# Step selectors: segments (click one, or ui.set by label or index) and arrows that wrap round.
{"method": "ui.click", "params": {"path": "Sample Menu 4/Game/Difficulty/Very Hard"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/Game/Difficulty", "kind": "step_selector"}, "path": "/widgets/0/value", "value": "Very Hard"}}
{"method": "ui.set", "params": {"path": "Sample Menu 4/Game/Difficulty", "value": "Easy"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/Game/Difficulty/Easy"}, "path": "/widgets/0/value", "value": true}}
{"method": "ui.click", "params": {"path": "Sample Menu 4/Game/Speed/Next"}}
{"method": "ui.click", "params": {"path": "Sample Menu 4/Game/Speed/Next"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/Game/Speed", "kind": "step_selector"}, "path": "/widgets/0/value", "value": "Slow"}}
# Menu items (one disabled), framed buttons of a set width, icon buttons (one toggles, one disabled).
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/Continue"}, "path": "/widgets/0/enabled", "value": false}}
{"method": "ui.hover", "params": {"path": "Sample Menu 4/Campaign"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/Campaign"}, "path": "/widgets/0/value/subline", "value": "Campaign I · mission 6 of 10"}}
{"method": "ui.click", "params": {"path": "Sample Menu 4/Campaign"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/Cancel"}, "path": "/widgets/0/rect/2", "value": 120.0}}
{"method": "ui.click", "params": {"path": "Sample Menu 4/temple"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/temple"}, "path": "/widgets/0/value", "value": true}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 4/fort"}, "path": "/widgets/0/enabled", "value": false}}
# Template list rows: a locked row can't be picked; the data widgets report what they show.
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 5/Realm/Kambara"}, "path": "/widgets/0/enabled", "value": false}}
{"method": "ui.click", "params": {"path": "Sample Menu 5/Map/Karst Valley"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 5/Map", "kind": "item_list"}, "path": "/widgets/0/value", "value": "Karst Valley"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 5/Map Stats"}, "path": "/widgets/0/value/1", "value": ["Rivers", "1 large, 3 streams"]}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 5/Goals"}, "path": "/widgets/0/value/status", "value": ["done", "pending", "failed"]}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 5/Culture"}, "path": "/widgets/0/value/value", "value": 62.0}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 5/Preview"}, "path": "/widgets/0/value/fit", "value": "cover"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Sample Menu 5/Stele", "kind": "rich_text"}, "path": "/widgets/0/value"}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "ui.click", "params": {"path": "Debug"}}
{"method": "ui.set", "params": {"path": "Debug/Show Widget Samples", "value": false}}
{"method": "ui.click", "params": {"path": "Debug"}}
# The log viewer's console: ui.set fills it in while it has keyboard focus, Enter runs it; or type it.
{"method": "ui.click", "params": {"path": "Debug"}}
{"method": "ui.set", "params": {"path": "Debug/Show Log Viewer Window", "value": true}}
{"method": "ui.set", "params": {"path": "Log Viewer/Console", "value": "sim.pause"}}
{"method": "input.key", "params": {"key": "Enter"}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": true}}
{"method": "input.type", "params": {"text": "sim.resume"}}
{"method": "input.key", "params": {"key": "Enter"}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": false}}
{"method": "ui.click", "params": {"path": "Log Viewer/Close"}}
{"method": "input.move", "params": {"park": true}}
{"method": "screenshot", "params": {"path": "out/ui_dev_menus.png", "scale": "points"}}
