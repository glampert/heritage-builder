# UI sound hooks (engine::ui::sound): the roles the widgets, dialogs, popups, toasts and minimap
# alerts play, as ui.sounds records them (with or without an audio device), the default mapping
# (Đại Long's skin's `sounds` block, assets/configs/ui/skins/dailong.json), and the dialogs' sounds
# through a skin switch. From the repository root:
#   cargo run -p HeritageBuilder -- --fresh-profile --script crates/game/tests/scenarios/ui_sounds.jsonl
# Run it without an audio device, as CI does: with one, a sound still playing can hold back the next
# (exclusivity). Cooldowns run on frame time, so with time.fixed_dt the list is the same every run.
# Each check reads the list and clears it (clear=true).
{"method": "time.fixed_dt", "params": {"dt": 0.016667}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"mapping": true}, "path": "/mapping/dialog_opened", "value": "buttons/default/pressed.wav"}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"mapping": true}, "path": "/mapping/alert", "value": "misc/default/tile_placement_failed.wav"}}
{"method": "wait.frames", "params": {"frames": 5}}
{"method": "ui.sounds", "params": {"clear": true}}

# A home menu item that opens a dialog: its hover and pick, then the dialog's open sound. Then a
# tab of the Settings dialog: tab_selected, and no hover sound.
{"method": "ui.click", "params": {"path": "Settings"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["item_hovered", "item_selected", "dialog_opened"]}}
{"method": "ui.click", "params": {"path": "MainSettings/Sound"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["tab_selected"]}}
{"method": "ui.click", "params": {"path": "MainSettings/Game"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "ui.sounds", "params": {"clear": true}}

# A toggle plays Toggled, and no hover sound. Cancel closes the dialog without saving the change.
{"method": "ui.click", "params": {"path": "MainSettings/Game/Autosave"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["toggled"]}}
{"method": "ui.click", "params": {"path": "MainSettings/Cancel"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["button_hovered", "button_pressed", "dialog_closed"]}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "Home"}}

# A dropdown: opened, an item hovered and picked (the pick closes it, so no dropdown_closed), then
# opened and closed again without a pick. GraphicsSettings opens the Settings dialog on its tab.
{"method": "dialog.open", "params": {"name": "GraphicsSettings"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "MainSettings"}}
{"method": "ui.sounds", "params": {"clear": true}}
{"method": "ui.click", "params": {"path": "Texture filtering"}}
{"method": "ui.click", "params": {"path": "Texture filtering/Nearest"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "ui.click", "params": {"path": "Texture filtering"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "ui.click", "params": {"path": "Texture filtering"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["dropdown_opened", "item_hovered", "item_selected", "dropdown_opened", "dropdown_closed"]}}

# Escape closes the dialog on top only: dialog_closed, and Home, under it, is on top again.
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true, "roles": ["dialog_closed"]}, "path": "/count", "value": 1}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "Home"}}

# A slider plays slider_changed at most once per its cooldown (0.2 s of frame time): of three moves
# in a few frames only the first plays, and a move after the cooldown plays again.
{"method": "dialog.open", "params": {"name": "SoundSettings"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "ui.sounds", "params": {"clear": true}}
{"method": "ui.set", "params": {"path": "SFX volume", "value": 50}}
{"method": "ui.set", "params": {"path": "SFX volume", "value": 40}}
{"method": "ui.set", "params": {"path": "SFX volume", "value": 30}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "ui.set", "params": {"path": "SFX volume", "value": 20}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["slider_changed", "slider_changed"]}}
{"method": "ui.click", "params": {"path": "MainSettings/Cancel"}}
{"method": "wait.frames", "params": {"frames": 15}}

# In game, a sprite button plays only its press (no hover sound by default), then its dialog opens.
{"method": "session.new_map", "params": {"size": [16, 16]}}
{"method": "wait.frames", "params": {"frames": 5}}
{"method": "ui.sounds", "params": {"clear": true}}
{"method": "ui.click", "params": {"path": "LeftBar/main_menu"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["button_pressed", "dialog_opened"]}}

# A popup opens and closes with its Cancel button, then opens and closes with Escape, which leaves
# the dialog under it open. Escape again closes the dialog.
{"method": "ui.click", "params": {"path": "MainGame/Quit to menu"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "ui.click", "params": {"path": "Quit Game Popup/Cancel"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "ui.click", "params": {"path": "MainGame/Quit to menu"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true, "roles": ["popup_opened", "popup_closed", "dialog_opened", "dialog_closed"]}, "path": "/roles", "value": ["popup_opened", "popup_closed", "popup_opened", "popup_closed"]}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "MainGame"}}
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true, "roles": ["popup_closed", "dialog_closed"]}, "path": "/roles", "value": ["dialog_closed"]}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "", "value": {"current": null}}}

# The build palette's sounds play as before: a road drawn, then the tool put away with Escape.
{"method": "ui.click", "params": {"path": "Roads"}}
{"method": "ui.click", "params": {"path": "Dirt Road"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "ui.sounds", "params": {"clear": true}}
{"method": "input.drag", "params": {"from": [5, 5], "to": [5, 12], "cells": true}}
{"method": "wait.frames", "params": {"frames": 5}}
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.frames", "params": {"frames": 5}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["tile_placed", "tile_placement_canceled"]}}

# Escape that closes a popup goes no further: the tool picked before the Game menu opened stays.
{"method": "ui.click", "params": {"path": "Roads"}}
{"method": "ui.click", "params": {"path": "Dirt Road"}}
{"method": "dialog.open", "params": {"name": "MainGame"}}
{"method": "ui.click", "params": {"path": "MainGame/Quit to menu"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "ui.sounds", "params": {"clear": true}}
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true, "roles": ["popup_closed", "dialog_closed", "tile_placement_canceled"]}, "path": "/roles", "value": ["popup_closed"]}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "MainGame"}}
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.frames", "params": {"frames": 15}}
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.frames", "params": {"frames": 5}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true, "roles": ["popup_closed", "dialog_closed", "tile_placement_canceled"]}, "path": "/roles", "value": ["dialog_closed", "tile_placement_canceled"]}}

# A building the player had built finished: its toast plays construction_completed once, and not
# notification.
{"method": "world.place", "params": {"tile": "storage_yard", "cell": [10, 3]}}
{"method": "time.fast_forward", "params": {"sim_secs": 16}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [10, 3]}, "path": "/kind", "value": "StorageYard"}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["construction_completed"]}}

# A new minimap alert plays alert; another at the same cell restarts that alert, quietly.
{"method": "minimap.alert", "params": {"cell": [8, 8]}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["alert"]}}
{"method": "wait.frames", "params": {"frames": 70}}
{"method": "minimap.alert", "params": {"cell": [8, 8]}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/count", "value": 0}}
{"method": "minimap.alert", "params": {"cell": [4, 9]}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["alert"]}}

# Debt notices: going into debt is a warning and plays alert; getting out of it is good news and
# plays notification. Each fast-forward crosses one month's end. First the last alert's cooldown
# (1 s of frame time) runs out.
{"method": "wait.frames", "params": {"frames": 70}}
{"method": "finance.set", "params": {"balance": -10}}
{"method": "time.fast_forward", "params": {"sim_secs": 60}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "finance.state", "path": "/months_in_debt", "value": 1}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["alert"]}}
{"method": "finance.set", "params": {"balance": 100}}
{"method": "time.fast_forward", "params": {"sim_secs": 60}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "finance.state", "path": "/months_in_debt", "value": 0}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"clear": true}, "path": "/roles", "value": ["notification"]}}

# A realm switch rebuilds the dialogs from the new skin (dialog::sync) while two are stacked: the
# stack stays, the reopened dialogs don't play their open sound again, and their close sound
# survives the rebuild. First the last sounds' cooldowns run out.
{"method": "wait.frames", "params": {"frames": 70}}
{"method": "dialog.open", "params": {"name": "MainGame"}}
{"method": "ui.click", "params": {"path": "MainGame/Settings"}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "MainSettings"}}
{"method": "wait.frames", "params": {"frames": 30}}
{"method": "ui.sounds", "params": {"clear": true}}
{"method": "ui.realm", "params": {"realm": "tampadesa"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "MainSettings"}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"roles": ["dialog_opened", "dialog_closed"], "clear": true}, "path": "/count", "value": 0}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "ui.reload_skin"}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "dialog.close", "params": {"name": "MainSettings"}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "MainGame"}}
{"method": "assert.eq", "params": {"query": "ui.sounds", "args": {"roles": ["dialog_opened", "dialog_closed"], "clear": true}, "path": "/roles", "value": ["dialog_closed"]}}
{"method": "dialog.close", "params": {"name": "MainGame"}}
{"method": "ui.realm", "params": {"realm": "auto"}}

# A realm switch with only the tile inspector open closes it, and the game runs again, as when the
# inspector is closed by hand: its own pause isn't put back.
{"method": "sim.resume"}
{"method": "input.click", "params": {"cell": [8, 8]}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": true}}
{"method": "ui.realm", "params": {"realm": "kambara"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": false}}
{"method": "ui.realm", "params": {"realm": "auto"}}
