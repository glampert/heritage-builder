# ---- In a game: the simulation stays paused while a sequence plays ----
{"method": "session.new_map", "params": {"size": [32, 32]}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "sim.resume"}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": false}}
{"method": "story.play", "params": {"campaign": "dragon_legacy", "sequence": "i_a"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": true}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "ui.click", "params": {"path": "StoryComic/bar/Skip"}}
{"method": "wait.until", "params": {"query": "dialog.list", "path": "/dialogs/StoryComic", "op": "eq", "value": false, "timeout_frames": 30}}
{"method": "assert.eq", "params": {"query": "sim.state", "path": "/paused", "value": false}}
{"method": "assert.eq", "params": {"query": "story.state", "args": {"campaign": "dragon_legacy"}, "path": "/seen", "value": []}}
