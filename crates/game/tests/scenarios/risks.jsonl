# City risks: every building's fire and collapse risk builds up month by month, more slowly near a
# well, and stops while risks are off for the game. A building on fire burns down and one that
# collapses falls at once; both leave rubble, which the clear tool removes. From the repository root:
#   cargo run -p HeritageBuilder -- --script crates/game/tests/scenarios/risks.jsonl
# A month is 60 simulated seconds, and a fire burns for 30. A fire watch sends a fire watcher to a
# fire within its reach, over any land, who puts it out and goes on to the next one
# (docs/plans/city-risks.md).
{"method": "time.fixed_dt", "params": {"dt": 0.016667}}
{"method": "session.new_map", "params": {"size": [32, 24]}}
{"method": "cheats.set", "params": {"name": "instant_construction", "value": true}}
{"method": "cheats.set", "params": {"name": "ignore_tile_cost", "value": true}}
{"method": "world.road", "params": {"from": [2, 10], "to": [29, 10]}}

# Two storage yards on the road, one beside a small well and one across the map from it.
{"method": "world.place", "params": {"tile": "storage_yard", "cell": [3, 11]}}
{"method": "world.place", "params": {"tile": "small_well", "cell": [7, 11]}}
{"method": "world.place", "params": {"tile": "storage_yard", "cell": [25, 11]}}
{"method": "assert.eq", "params": {"query": "risks.state", "path": "/active", "value": true}}
{"method": "assert.eq", "params": {"query": "risks.state", "path": "/buildings", "value": 3}}
{"method": "time.fast_forward", "params": {"sim_secs": 60}}
{"method": "risks.state"}

# A month on, both yards have built up risk. The one by the well has water, and its fire risk
# builds up at half its rate: a storage yard's rate is 4 a month, give or take a quarter.
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [3, 11]}, "path": "/risks/near_water", "value": true}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [25, 11]}, "path": "/risks/near_water", "value": false}}
{"method": "assert.lt", "params": {"query": "world.building_at", "args": {"cell": [3, 11]}, "path": "/risks/rates/fire", "value": 2.6}}
{"method": "assert.gt", "params": {"query": "world.building_at", "args": {"cell": [25, 11]}, "path": "/risks/rates/fire", "value": 2.9}}
{"method": "assert.gt", "params": {"query": "world.building_at", "args": {"cell": [25, 11]}, "path": "/risks/fire", "value": 2.9}}
{"method": "assert.gt", "params": {"query": "world.building_at", "args": {"cell": [25, 11]}, "path": "/risks/collapse", "value": 2.0}}

# Set a risk by hand: the far yard is now the riskiest building, and at high risk.
{"method": "risks.set", "params": {"cell": [25, 11], "fire": 90}}
{"method": "assert.eq", "params": {"query": "risks.state", "path": "/riskiest/0/cell", "value": [25, 11]}}
{"method": "assert.eq", "params": {"query": "risks.state", "path": "/high/fire", "value": 1}}

# Risks off for the game: nothing builds up. On again: it does.
{"method": "risks.set", "params": {"enabled": false}}
{"method": "time.fast_forward", "params": {"sim_secs": 60}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [25, 11]}, "path": "/risks/fire", "value": 90.0}}
{"method": "risks.set", "params": {"enabled": true}}
{"method": "time.fast_forward", "params": {"sim_secs": 60}}
{"method": "assert.gt", "params": {"query": "world.building_at", "args": {"cell": [25, 11]}, "path": "/risks/fire", "value": 92.0}}

# A fire: the far yard burns for 30 seconds, then leaves a 3x3 pile of rubble.
{"method": "risks.ignite", "params": {"cell": [25, 11]}}
{"method": "assert.eq", "params": {"query": "risks.state", "path": "/burning", "value": 1}}
{"method": "assert.eq", "params": {"query": "risks.state", "path": "/fires/0/cell", "value": [25, 11]}}
{"method": "assert.gt", "params": {"query": "world.building_at", "args": {"cell": [25, 11]}, "path": "/risks/burning/secs_left", "value": 29.0}}
{"method": "time.fast_forward", "params": {"sim_secs": 32}}
{"method": "assert.eq", "params": {"query": "risks.state", "path": "/burning", "value": 0}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [25, 11]}, "path": "/objects/0/name", "value": "rubble"}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [26, 12]}, "path": "/objects/0/variation_name", "value": "1111"}}

# Clearing the middle of the pile reshapes the pieces around it: the one north of it (+x) no
# longer runs south.
{"method": "world.clear", "params": {"cell": [26, 12]}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [27, 12]}, "path": "/objects/0/variation_name", "value": "0101"}}

# A collapse: the yard by the well falls at once. Only the well is left.
{"method": "risks.collapse", "params": {"cell": [4, 12]}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [3, 11]}, "path": "/objects/0/variation_name", "value": "1001"}}
{"method": "assert.eq", "params": {"query": "risks.state", "path": "/buildings", "value": 1}}
{"method": "risks.state"}

# A house stands on a vacant lot, where nothing else can go. Once it has burnt down, the lot is
# grass again, under the rubble.
{"method": "world.place", "params": {"tile": "vacant_lot", "cell": [8, 18]}}
{"method": "world.place", "params": {"tile": "house0", "cell": [8, 18]}}
{"method": "risks.ignite", "params": {"cell": [8, 18]}}
{"method": "time.fast_forward", "params": {"sim_secs": 32}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [8, 18]}, "path": "/objects/0/name", "value": "rubble"}}
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [8, 18]}, "path": "/terrain/name", "value": "grass"}}

# The fire watch and the builders' guild, staffed without residents. Two fires in the fire watch's
# reach: a yard on the road and a house off it, past the yard. The fire watcher puts out the yard,
# then walks over the grass to the house, and both are out within 14 seconds; going home between
# them would take him about 17.
{"method": "cheats.set", "params": {"name": "ignore_worker_requirements", "value": true}}
{"method": "world.place", "params": {"tile": "fire_watch", "cell": [12, 11]}}
{"method": "world.place", "params": {"tile": "builders_guild", "cell": [14, 11]}}
{"method": "world.place", "params": {"tile": "storage_yard", "cell": [20, 11]}}
{"method": "world.place", "params": {"tile": "vacant_lot", "cell": [20, 16]}}
{"method": "world.place", "params": {"tile": "house0", "cell": [20, 16]}}
{"method": "risks.ignite", "params": {"cell": [20, 11]}}
{"method": "risks.ignite", "params": {"cell": [20, 16]}}
{"method": "time.fast_forward", "params": {"sim_secs": 14}}
{"method": "assert.eq", "params": {"query": "risks.state", "path": "/burning", "value": 0}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [20, 11]}, "path": "/name", "value": "Storage Yard"}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [20, 16]}, "path": "/name", "value": "House Level 0"}}
# Its fire risk went back to 0 and has built up for some seconds since.
{"method": "assert.lt", "params": {"query": "world.building_at", "args": {"cell": [20, 11]}, "path": "/risks/fire", "value": 2.0}}
