# The developer editor's Screens menu (debug::screens; docs/plans/realm-ui.md, Phase 4): opens the
# retail screens that are hard to reach in play as previews (menu::dialog::preview), for a campaign
# and mission picked in it, over the city in the in-game menus, and goes back to the editor once
# they close. For each hidden test campaign, in its realm's look: the briefing (its Replay the
# story), the briefing with a choice point's sites, the debrief (its Continue plays the sequence
# after the mission, then the world map with the next mission's choice), the world map during the
# mission, the Finish Mission and Choose Site popups (whose Begin starts nothing), the
# campaign-complete screen (test_choices' Watch the epilogue) and a story sequence. Then Campaign
# I: its Begin Mission popup, and in Kambara's look (Screens/Realm, the ui.realm override) its
# debrief, whose Continue goes to the next mission (Kambara's map is Campaign II's) and starts
# nothing, and I-B, a sequence whose mission isn't written yet. After each: the editor is back,
# the profile is empty, no mission is being played and the map is the same; the simulation's
# pause is kept. Layout issues 0 on every screen. Screenshots go to out/ui_dev_screens/.
#
# Run it with --fresh-profile, as CI does, at 1280 × 720, 1440 × 800 (CI's) and 1920 × 1080:
#   cargo run -p HeritageBuilder -- --fresh-profile --window-size 1440x800 --script crates/game/tests/scenarios/ui_dev_screens.jsonl
{"method": "time.fixed_dt", "params": {"dt": 0.016667}}
{"method": "session.new_map", "params": {"size": [16, 16]}}
# Paused from here to the Escape below: the previews keep it paused, not one simulation frame runs (sim_time stays).
{"method": "sim.pause", "params": {}}
{"method": "menus.mode", "params": {"mode": "DevEditor"}}
{"method": "input.move", "params": {"park": true}}
# Listing the widgets turns the widget registry on, for the ui.tree queries below.
{"method": "ui.tree", "params": {"filter": "Screens", "fields": ["path"]}}

# The menu: the realm (auto follows the campaign), the campaign, the mission, a button per screen, the sequences.
{"method": "ui.click", "params": {"path": "Screens"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Screens/Realm"}, "path": "/widgets/0/value", "value": "auto"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Screens/Campaign"}, "path": "/widgets/0/value", "value": "dragon_legacy"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Screens/Mission"}, "path": "/widgets/0/value", "value": "1 · A Humble Beginning"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Screens/Mission briefing"}, "path": "/widgets/0"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Screens/Debrief"}, "path": "/widgets/0"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Screens/Campaign complete"}, "path": "/widgets/0"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Screens/World map after the mission"}, "path": "/widgets/0"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Screens/World map during the mission"}, "path": "/widgets/0"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Screens/Begin Mission Popup"}, "path": "/widgets/0"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "Screens/Play sequence"}, "path": "/widgets/0"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Screens/Sequence"}, "path": "/widgets/0/value", "value": "i_a"}}
# Campaign II has no missions yet: no mission screens, no sequences.
{"method": "ui.set", "params": {"path": "Screens/Campaign", "value": "temple_mountain"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Screens/Debrief"}, "path": "/widgets", "value": []}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Screens/Play sequence"}, "path": "/widgets", "value": []}}
{"method": "ui.click", "params": {"path": "Screens"}}
{"method": "wait.frames", "params": {"frames": 2}}

