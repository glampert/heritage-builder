# A story sequence: Escape skips it, and it isn't recorded seen.
{"method": "ui.click", "params": {"path": "Screens"}}
{"method": "ui.set", "params": {"path": "Screens/Campaign", "value": "test_choices_tampadesa"}}
{"method": "ui.set", "params": {"path": "Screens/Sequence", "value": "test_after"}}
{"method": "ui.click", "params": {"path": "Screens/Play sequence"}}
{"method": "wait.until", "params": {"query": "dialog.current", "path": "/current", "op": "eq", "value": "StoryComic", "timeout_frames": 30}}
{"method": "assert.eq", "params": {"query": "ui.realm", "path": "/realm", "value": "tampadesa"}}
{"method": "assert.eq", "params": {"query": "story.state", "args": {"campaign": "test_choices_tampadesa"}, "path": "/playing", "value": {"campaign": "test_choices_tampadesa", "sequence": "test_after", "panel": 1}}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.until", "params": {"query": "session.state", "path": "/menus_mode", "op": "eq", "value": "DevEditor", "timeout_frames": 30}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "", "value": {"current": null}}}
{"method": "assert.eq", "params": {"query": "profile.state", "path": "/profile/campaigns", "value": []}}
{"method": "assert.eq", "params": {"query": "ui.realm", "path": "/source", "value": "default"}}
{"method": "assert.eq", "params": {"query": "session.state", "path": "/map_size", "value": [16, 16]}}
{"method": "assert.eq", "params": {"query": "story.state", "args": {"campaign": "test_choices_tampadesa"}, "path": "/seen", "value": []}}

