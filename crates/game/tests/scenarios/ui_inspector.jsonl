# The inspector (docs/plans/realm-ui.md, Phase 8): a panel for each kind of thing clicked, as
# inspector-<kind>-<realm>.jpg lays it out. Builds a small city, checks what inspect.at reports of
# each kind, opens each panel from a click in each realm and checks its widgets and layout, then the
# actions: a store's orders (one good, Accept all, Accept none) and that a refused good goes to
# another store, Demolish and its popup, a site's Cancel and refund, Clear on a road, and a walker
# without a home. Saves screenshots to out/ui_inspector/.
# From the repository root:
#   cargo run -p HeritageBuilder -- --fresh-profile --default-configs --window-size 1920x1080 --script crates/game/tests/scenarios/ui_inspector.jsonl
{"method": "time.fixed_dt", "params": {"dt": 0.016667}}
{"method": "session.new_map", "params": {"size": [32, 32]}}
{"method": "finance.set", "params": {"balance": 2000}}
{"method": "cheats.set", "params": {"name": "instant_construction", "value": true}}
{"method": "cheats.set", "params": {"name": "ignore_worker_requirements", "value": true}}
{"method": "cheats.set", "params": {"name": "no_city_risks", "value": true}}
{"method": "world.road", "params": {"from": [3, 13], "to": [28, 13]}}
{"method": "world.place", "params": {"tile": "water", "cell": [8, 10]}}
{"method": "world.place", "params": {"tile": "water", "cell": [9, 10]}}
{"method": "world.place", "params": {"tile": "storage_yard", "cell": [4, 10]}}
{"method": "world.place", "params": {"tile": "storage_yard", "cell": [24, 14]}}
{"method": "world.add_stock", "params": {"resources": {"Wood": 40, "Bricks": 40, "RoofTiles": 16}}}
{"method": "world.place", "params": {"tile": "clay_pit", "cell": [8, 11]}}
{"method": "world.place", "params": {"tile": "roof_tile_kiln", "cell": [11, 11]}}
{"method": "world.place", "params": {"tile": "market", "cell": [14, 11]}}
{"method": "world.place", "params": {"tile": "fire_watch", "cell": [17, 12]}}
{"method": "world.place", "params": {"tile": "granary", "cell": [19, 10]}}
{"method": "world.place", "params": {"tile": "house0", "cell": [6, 14]}}
{"method": "world.place", "params": {"tile": "small_well", "cell": [9, 14]}}
{"method": "time.fast_forward", "params": {"sim_secs": 120}}
{"method": "finance.set", "params": {"balance": 2000}}
{"method": "cheats.set", "params": {"name": "instant_construction", "value": false}}
{"method": "world.place", "params": {"tile": "temple", "cell": [22, 10]}}

# What the panels read (inspect.at), any cell of a building.
