# Get and Empty send the store's runner (docs/plans/messages.md, Phase 2): the second yard set to
# Get bricks fetches a load from the first, its panel saying so; set to Empty, it carries them out
# to a third yard with room (the first's slots fill with the clay pit's clay), until it holds none.
{"method": "cheats.set", "params": {"name": "instant_construction", "value": true}}
{"method": "world.place", "params": {"tile": "storage_yard", "cell": [22, 24]}}
{"method": "storage.orders", "params": {"cell": [34, 24], "good": "Bricks", "order": "get"}}
{"method": "wait.until", "params": {"query": "world.building_at", "args": {"cell": [34, 24]}, "path": "/storage/errand/order", "op": "eq", "value": "get", "timeout_frames": 900}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [34, 24]}, "path": "/errand", "value": {"order": "get", "good": "Bricks", "count": 8}}}
{"method": "camera.teleport", "params": {"cell": [34, 24]}}
{"method": "input.click", "params": {"cell": [34, 24]}}
{"method": "input.move", "params": {"park": true}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [34, 24]}, "path": "/sections/2/section", "value": "errand"}}
{"method": "assert.eq", "params": {"query": "ui.layout_issues", "path": "/count", "value": 0}}
{"method": "screenshot", "params": {"path": "out/ui_inspector/storage_get.png"}}
{"method": "ui.click", "params": {"path": "BuildingInspector/Close"}}
{"method": "wait.until", "params": {"query": "world.building_at", "args": {"cell": [34, 24]}, "path": "/stock/Bricks", "op": "ge", "value": 16, "timeout_frames": 3600}}
{"method": "storage.orders", "params": {"cell": [34, 24], "good": "Bricks", "order": "empty"}}
{"method": "wait.until", "params": {"query": "world.building_at", "args": {"cell": [34, 24]}, "path": "/storage/errand/order", "op": "eq", "value": "empty", "timeout_frames": 900}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [34, 24]}, "path": "/storage/errand/good", "value": "Bricks"}}
{"method": "time.fast_forward", "params": {"sim_secs": 180}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [34, 24]}, "path": "/sections/1/rows/8/good", "value": "Bricks"}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [34, 24]}, "path": "/sections/1/rows/8/have", "value": 0}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [34, 24]}, "path": "/storage/cannot_empty", "value": []}}
{"method": "storage.orders", "params": {"cell": [34, 24], "good": "Bricks", "order": "accept"}}

