{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [4, 10]}, "path": "/sections/1/section", "value": "storage"}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [11, 11]}, "path": "/panel", "value": "workshop"}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [11, 11]}, "path": "/name", "value": "Roof tile kiln"}}
