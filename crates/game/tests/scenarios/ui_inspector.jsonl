# A store's orders: one good from its row, then Accept none and Accept all. A refused good goes to
# another store.
{"method": "camera.teleport", "params": {"cell": [14, 20]}}
{"method": "input.click", "params": {"cell": [14, 20]}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "ui.set", "params": {"path": "BuildingInspector/Bricks", "value": "Refuse"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [14, 20]}, "path": "/orders/Bricks", "value": "refuse"}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [14, 20]}, "path": "/sections/1/rows/8/order", "value": "refuse"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"fields": ["path", "value"], "filter": "BuildingInspector/Bricks", "kind": "step_selector"}, "path": "/widgets/0/value", "value": "Refuse"}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [14, 20]}, "path": "/stock/Bricks", "value": 32}}
{"method": "world.add_stock", "params": {"resources": {"Bricks": 8}}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [14, 20]}, "path": "/stock/Bricks", "value": 32}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [34, 24]}, "path": "/stock/Bricks", "value": 8}}
{"method": "ui.set", "params": {"path": "BuildingInspector/Clay", "value": "Empty"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [14, 20]}, "path": "/orders/Clay", "value": "empty"}}
{"method": "ui.click", "params": {"path": "BuildingInspector/Accept none"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [14, 20]}, "path": "/orders/Rice", "value": "refuse"}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [14, 20]}, "path": "/orders/Clay", "value": "refuse"}}
{"method": "screenshot", "params": {"path": "out/ui_inspector/storage_refused.png"}}
{"method": "ui.click", "params": {"path": "BuildingInspector/Accept all"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [14, 20]}, "path": "/orders/Bricks", "value": "accept"}}
{"method": "storage.orders", "params": {"cell": [14, 20], "good": "Wood", "order": "get"}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [14, 20]}, "path": "/orders/Wood", "value": "get"}}
{"method": "storage.orders", "params": {"cell": [14, 20], "good": "Wood", "order": "accept"}}
