# A walker without a home: Show its home is disabled.
{"method": "camera.teleport", "params": {"cell": [26, 13]}}
{"method": "input.click", "params": {"cell": [26, 13]}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"fields": ["path", "enabled"], "filter": "UnitInspector/Show its home"}, "path": "/widgets/0/enabled", "value": false}}
{"method": "ui.click", "params": {"path": "UnitInspector/Close"}}

# A store's orders: one good from its row, then Accept none and Accept all. A refused good goes to
# another store.
{"method": "camera.teleport", "params": {"cell": [4, 10]}}
{"method": "input.click", "params": {"cell": [4, 10]}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "ui.set", "params": {"path": "BuildingInspector/Bricks", "value": "Refuse"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [4, 10]}, "path": "/orders/Bricks", "value": "refuse"}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [4, 10]}, "path": "/sections/1/rows/8/order", "value": "refuse"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"fields": ["path", "value"], "filter": "BuildingInspector/Bricks", "kind": "step_selector"}, "path": "/widgets/0/value", "value": "Refuse"}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [4, 10]}, "path": "/stock/Bricks", "value": 32}}
{"method": "world.add_stock", "params": {"resources": {"Bricks": 8}}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [4, 10]}, "path": "/stock/Bricks", "value": 32}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [24, 14]}, "path": "/stock/Bricks", "value": 8}}
{"method": "ui.set", "params": {"path": "BuildingInspector/Clay", "value": "Empty"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [4, 10]}, "path": "/orders/Clay", "value": "empty"}}
{"method": "ui.click", "params": {"path": "BuildingInspector/Accept none"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [4, 10]}, "path": "/orders/Rice", "value": "refuse"}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [4, 10]}, "path": "/orders/Clay", "value": "refuse"}}
{"method": "screenshot", "params": {"path": "out/ui_inspector/storage_refused.png"}}
{"method": "ui.click", "params": {"path": "BuildingInspector/Accept all"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [4, 10]}, "path": "/orders/Bricks", "value": "accept"}}
{"method": "storage.orders", "params": {"cell": [4, 10], "good": "Wood", "order": "get"}}
{"method": "assert.eq", "params": {"query": "storage.orders", "args": {"cell": [4, 10]}, "path": "/orders/Wood", "value": "get"}}
{"method": "ui.click", "params": {"path": "BuildingInspector/Close"}}

# Demolish asks first; Cancel keeps the building, Demolish clears it (nothing given back).
{"method": "camera.teleport", "params": {"cell": [9, 14]}}
{"method": "input.click", "params": {"cell": [9, 14]}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "ui.click", "params": {"path": "BuildingInspector/Demolish"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "screenshot", "params": {"path": "out/ui_inspector/demolish_popup.png"}}
{"method": "ui.click", "params": {"path": "Demolish Popup/Cancel"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "world.building_at", "args": {"cell": [9, 14]}, "path": "/kind", "value": "SmallWell"}}
{"method": "ui.click", "params": {"path": "BuildingInspector/Demolish"}}
{"method": "ui.click", "params": {"path": "Demolish Popup/Demolish"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [9, 14]}, "path": "/panel", "value": "terrain"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "BuildingInspector/"}, "path": "/widgets", "value": []}}

# A site's Cancel and refund gives back its gold and materials.
{"method": "assert.eq", "params": {"query": "finance.state", "path": "/this_year/categories/Construction", "value": 107}}
{"method": "camera.teleport", "params": {"cell": [22, 10]}}
{"method": "input.click", "params": {"cell": [22, 10]}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "ui.click", "params": {"path": "BuildingInspector/Cancel and refund"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "finance.state", "path": "/this_year/categories/Construction", "value": 92}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [22, 10]}, "path": "/panel", "value": "terrain"}}

# Clear on a road leaves grass.
{"method": "camera.teleport", "params": {"cell": [27, 13]}}
