{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [9, 14]}, "path": "/actions/0/kind", "value": "demolish"}}
{"method": "assert.eq", "params": {"query": "inspect.at", "args": {"cell": [22, 10]}, "path": "/panel", "value": "site"}}
