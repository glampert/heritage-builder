# Starts a new game from the home menu the way a player would: clicking menu buttons with the
# simulated mouse (ui.click) and filling in the Custom Game dialog's Blank map (ui.set). From the
# repository root:
#   cargo run -p HeritageBuilder -- --script crates/game/tests/scenarios/ui_new_game.jsonl
{"method": "time.fixed_dt", "params": {"dt": 0.016667}}
{"method": "assert.eq", "params": {"query": "session.state", "path": "/menus_mode", "value": "Home"}}
{"method": "ui.click", "params": {"path": "Home/Custom Game"}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "CustomGame"}}
# Each dialog is its own window, its widgets under its own label; Home's, under it, is hidden: not
# drawn, so none of its widgets are listed.
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "CustomGame/Start"}, "path": "/widgets/0"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "Home/"}, "path": "/widgets", "value": []}}
# The Blank map comes first, picked, with its width, height and terrain under the preview.
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CustomGame/Map", "kind": "item_list"}, "path": "/widgets/0/value", "value": "Blank map"}}
{"method": "ui.set", "params": {"path": "CustomGame/Width", "value": "64"}}
{"method": "ui.set", "params": {"path": "CustomGame/Height", "value": "96"}}
{"method": "ui.click", "params": {"path": "CustomGame/Terrain/Next"}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CustomGame/Terrain", "kind": "step_selector"}, "path": "/widgets/0/value", "value": "Dirt"}}
{"method": "wait.frames", "params": {"frames": 2}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CustomGame/Map/Blank map"}, "path": "/widgets/0/value/right", "value": "64 × 96"}}
# Escape with a dropdown's list open closes the list only, and the dialog stays.
{"method": "ui.click", "params": {"path": "CustomGame/Starting treasury"}}
{"method": "assert.exists", "params": {"query": "ui.tree", "args": {"filter": "CustomGame/Starting treasury/1,000 gold"}, "path": "/widgets/0"}}
{"method": "input.key", "params": {"key": "Escape"}}
{"method": "wait.frames", "params": {"frames": 3}}
{"method": "assert.eq", "params": {"query": "ui.tree", "args": {"filter": "CustomGame/Starting treasury/"}, "path": "/widgets", "value": []}}
{"method": "assert.eq", "params": {"query": "dialog.current", "path": "/current", "value": "CustomGame"}}
{"method": "ui.click", "params": {"path": "CustomGame/Start"}}
{"method": "wait.until", "params": {"query": "session.state", "path": "/menus_mode", "op": "eq", "value": "InGame", "timeout_frames": 60}}
{"method": "assert.eq", "params": {"query": "session.state", "path": "/map_size", "value": [64, 96]}}
{"method": "assert.eq", "params": {"query": "session.state", "path": "/custom_game/map", "value": "blank"}}
# New maps keep only the playable diamond: corner cells such as [10, 10] have no terrain.
{"method": "assert.eq", "params": {"query": "tile.at", "args": {"cell": [32, 48]}, "path": "/terrain/name", "value": "dirt"}}
